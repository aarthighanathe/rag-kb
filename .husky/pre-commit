#!/bin/sh
# Husky pre-commit hook
# Runs on every git commit: lint → format → type-check → unit tests
# All steps must pass or the commit is aborted.

set -e

echo "🔍 Running pre-commit checks..."

# 1. ESLint/Prettier on staged files. Run from repo root so lint-staged's
#    root-relative glob patterns in package.json match correctly; eslint and
#    prettier live under backend/ and frontend/'s own node_modules (not
#    hoisted to the root), so both bin dirs are added to PATH for this step.
echo "\n→ ESLint..."
PATH="$PWD/backend/node_modules/.bin:$PWD/frontend/node_modules/.bin:$PATH" npx lint-staged

# 2. Type-check (no emit — just verify types)
echo "\n→ Type-check..."
cd backend && npm run type-check
cd ..

# 3. Unit tests only (fast — lint, type-check, complexity-audit, unit tests,
#    and integration tests all run again in CI on every PR against main;
#    see .github/workflows/ci.yml)
echo "\n→ Unit tests..."
cd backend && npm run test:unit
cd ..

echo "\n✅ All pre-commit checks passed."
